#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TYPST_TOML="${ROOT_DIR}/typst.toml"

if [[ ! -f "${TYPST_TOML}" ]]; then
  echo "typst.toml not found at ${TYPST_TOML}" >&2
  exit 1
fi

readarray -t _pkg_meta < <(python3 - "${TYPST_TOML}" <<'PY'
import sys
import tomllib

path = sys.argv[1]
with open(path, "rb") as f:
    data = tomllib.load(f)

pkg = data.get("package", {})
name = pkg.get("name")
version = pkg.get("version")
if not name or not version:
    raise SystemExit("typst.toml missing package.name or package.version")

print(name)
print(version)
PY
)

PKG_PREFIX="${_pkg_meta[0]}"
VERSION="${_pkg_meta[1]}"

export PKG_PREFIX
export VERSION
